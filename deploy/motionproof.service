# /etc/systemd/system/motionproof.service
# Runs MotionProof as an unprivileged user with a read-only view of the system.
[Unit]
Description=MotionProof
After=network-online.target
Wants=network-online.target

[Service]
User=motionproof
Group=motionproof
# MuJoCo writes its log into the working directory, so this must be writable
WorkingDirectory=/var/lib/motionproof
Environment=MOTIONPROOF_EXTERNAL_DATA=/var/lib/motionproof/external_data
# optional settings and secrets (the AI key, MOTIONPROOF_WORKERS, ...); chmod 600, owned by root
EnvironmentFile=-/etc/motionproof.env
ExecStart=/opt/motionproof/.venv/bin/motionproof serve --production --host 127.0.0.1 --port 8000 --home /var/lib/motionproof/workspace
Restart=on-failure
RestartSec=5

NoNewPrivileges=true
PrivateTmp=true
PrivateDevices=true
ProtectSystem=strict
ProtectHome=true
ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true
ReadWritePaths=/var/lib/motionproof

[Install]
WantedBy=multi-user.target
