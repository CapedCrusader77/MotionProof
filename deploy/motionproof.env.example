# Copy to /etc/motionproof.env, then: sudo chown root:root /etc/motionproof.env && sudo chmod 600 /etc/motionproof.env
# Every line is optional. Never commit a real key.

# Worker processes for large experiments (default: half the cores, at most 4)
#MOTIONPROOF_WORKERS=2

# Cloud AI assistant (see docs/ai-assistant.md); the key stays on the server
#MOTIONPROOF_AI_PROVIDER=anthropic
#MOTIONPROOF_AI_KEY=
#MOTIONPROOF_AI_DAILY_LIMIT=30

# Other origins that may send state-changing requests (default: the site itself)
#MOTIONPROOF_ALLOWED_ORIGINS=
